<?xml version="1.0" encoding="utf-8"?>
<!--
  Visual Studio 2022+ project for the Xbox build. A thin Makefile/NMake wrapper: it drives the
  RXDK CLI (Rxdk.Cli.exe), which reads rxdk.project.json, compiles, links, bundles the dashboard
  icons and packs the XISO. The CLI is the single source of truth, so setup.py, Rxdk.Cli build
  and Build here all produce the same out\<Config>\XISO\SSB-X.iso.

  First run setup.py once with its skip-build flag: it fetches the decomp, exports the assets
  from your ROM, stages data\ and writes rxdk.project.json. Then open ssb64x.sln, pick the Xbox
  platform, and Build. F5 is the Xbox Debugger (RXDK).

  Needs the RXDK toolchain: Rxdk.Cli under ProgramData\RXDK, on PATH, or the RxdkCli property.
-->
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|Xbox">
      <Configuration>Debug</Configuration>
      <Platform>Xbox</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|Xbox">
      <Configuration>Release</Configuration>
      <Platform>Xbox</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <VCProjectVersion>16.0</VCProjectVersion>
    <ProjectGuid>{52A4D51C-B137-52FF-B64D-25D13693AA17}</ProjectGuid>
    <RootNamespace>ssb64x</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
    <ProjectName>ssb64x</ProjectName>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>Makefile</ConfigurationType>
    <PlatformToolset Condition="'$(VisualStudioVersion)' == '17.0'">v143</PlatformToolset>
    <PlatformToolset Condition="'$(VisualStudioVersion)' == '18.0'">v145</PlatformToolset>
    <PlatformToolset Condition="'$(PlatformToolset)' == ''">v143</PlatformToolset>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />

  <!-- Rxdk.Cli.exe: an explicit RxdkCli property wins, then the standard install, else PATH. -->
  <PropertyGroup>
    <RxdkCli Condition="'$(RxdkCli)' == '' And Exists('$(ProgramData)\RXDK\tools\Rxdk.Cli.exe')">$(ProgramData)\RXDK\tools\Rxdk.Cli.exe</RxdkCli>
    <RxdkCli Condition="'$(RxdkCli)' == '' And Exists('$(ProgramData)\RXDK\engine\Rxdk.Cli.exe')">$(ProgramData)\RXDK\engine\Rxdk.Cli.exe</RxdkCli>
    <RxdkCli Condition="'$(RxdkCli)' == ''">Rxdk.Cli.exe</RxdkCli>
    <OutRoot>$(MSBuildProjectDirectory)\out\$(Configuration)</OutRoot>
  </PropertyGroup>

  <!-- Build through the CLI; Clean/Rebuild clear out\<Config> first (the CLI has no clean verb). -->
  <PropertyGroup>
    <NMakeBuildCommandLine>"$(RxdkCli)" build --project-root "$(MSBuildProjectDirectory)" --configuration $(Configuration)</NMakeBuildCommandLine>
    <NMakeReBuildCommandLine>cmd /c (if exist "$(OutRoot)" rmdir /s /q "$(OutRoot)") &amp; "$(RxdkCli)" build --project-root "$(MSBuildProjectDirectory)" --configuration $(Configuration)</NMakeReBuildCommandLine>
    <NMakeCleanCommandLine>cmd /c if exist "$(OutRoot)" rmdir /s /q "$(OutRoot)"</NMakeCleanCommandLine>
    <NMakeOutput>$(OutRoot)\XISO\SSB-X.iso</NMakeOutput>
    <!-- IntelliSense: mirrors rxdk.project.json's include paths and defines. -->
    <NMakeIncludeSearchPath>$(MSBuildProjectDirectory)\Platform\xbox;$(MSBuildProjectDirectory)\src\dc;$(MSBuildProjectDirectory)\src\dc\decomp;$(MSBuildProjectDirectory)\extern\ssb-decomp-re\src;$(MSBuildProjectDirectory)\src\game\ssb64;$(MSBuildProjectDirectory)\extern\decomp_include;$(ProgramData)\RXDK\sdk\include;$(NMakeIncludeSearchPath)</NMakeIncludeSearchPath>
    <NMakePreprocessorDefinitions>_XBOX;XBOX;_arch_dreamcast;_arch_sub_pristine;TARGET_XBOX=1;_LANGUAGE_C;F3DEX_GBI_2;REGION_US;AVOID_UB;MTX_BACKEND=MTX_BACKEND_SCALAR;SSB_RELEASE=1;DB_ENABLE=0;NDEBUG;$(NMakePreprocessorDefinitions)</NMakePreprocessorDefinitions>
  </PropertyGroup>

  <!-- For browsing; the build takes its source list from rxdk.project.json. -->
  <ItemGroup>
    <ClCompile Include="Platform\xbox\**\*.c" />
    <ClInclude Include="Platform\xbox\**\*.h" />
    <ClCompile Include="src\dc\**\*.c" />
    <ClInclude Include="src\dc\**\*.h" />
    <ClCompile Include="src\game\ssb64\main.c" />
  </ItemGroup>
  <ItemGroup>
    <None Include="rxdk.project.json" />
    <None Include="setup.py" />
    <None Include="README.md" />
    <None Include="Platform\xbox\titleimage.rdf" />
    <None Include="Platform\xbox\saveimage.rdf" />
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>

 struct FTMotionEventDefault // Event with no arguments
 {
+/*
+ * Every FTMotionEvent* word below decodes script data out of the
+ * fighters' motion files, so the bit-fields have to land on the same bits
+ * on either ABI. Within each 32-bit word the order is reversed where the
+ * compiler says it is building little-endian, as sys/objtypes.h does for
+ * the AObj event words, and a word the fields do not fill gets the
+ * padding the big-endian layout leaves below them declared first, so the
+ * fields keep their bit positions. IDO defines no __BYTE_ORDER__, so the
+ * N64 build sees the declarations it always did.
+ */
+#if defined(__BYTE_ORDER__) && (__BYTE_ORDER__ == __ORDER_LITTLE_ENDIAN__)
+    u32 value : 26;
+	u32 opcode : 6;
+#else
 	u32 opcode : 6;
     u32 value : 26;
+#endif
 };
 

 struct GMColEventDefault
 {
+/*
+ * Every GMColEvent* word below decodes a colour-animation script
+ * (gm/gmcolscripts.c, built by gm/gmdef.h's gmColCommand* macros with the
+ * opcode in the top six bits), so the bit-fields have to land on the same
+ * bits on either ABI. Within each 32-bit word the order is reversed where
+ * the compiler says it is building little-endian, as ft/fttypes.h does for
+ * the motion-event words and sys/objtypes.h for the AObj event words, and
+ * a word the fields do not fill gets the padding the big-endian layout
+ * leaves below them declared first, so the fields keep their bit
+ * positions. IDO defines no __BYTE_ORDER__, so the N64 build sees the
+ * declarations it always did.
+ */
+#if defined(__BYTE_ORDER__) && (__BYTE_ORDER__ == __ORDER_LITTLE_ENDIAN__)
+	u32 value : 26;
+	u32 opcode : 6;
+#else
 	u32 opcode : 6;
 	u32 value : 26;
+#endif
 };
 

diff --git a/src/ft/fttypes.h b/src/ft/fttypes.h
index c59c9c3cb..94323a148 100644
--- a/src/ft/fttypes.h
+++ b/src/ft/fttypes.h
@@ -51,6 +51,25 @@ union FTAnimDesc
 
     struct
     {
+/*
+ * `word` is the animation flags word out of each fighter's FTMotionDesc
+ * table, so the bit-fields have to land on the same bits of it on either
+ * ABI; the order is reversed where the compiler says it is building
+ * little-endian, as sys/objtypes.h does for the AObj event words. IDO
+ * defines no __BYTE_ORDER__, so the N64 build sees the declaration it
+ * always did.
+ */
+#if defined(__BYTE_ORDER__) && (__BYTE_ORDER__ == __ORDER_LITTLE_ENDIAN__)
+        ub32 is_use_animlocks : 1;          // 0x00000001
+        ub32 is_use_shieldpose : 1;         // 0x00000002
+        ub32 is_have_translate_scale : 1;   // 0x00000004
+        ub32 is_anim_joint : 1;             // 0x00000008
+        ub32 is_use_submotion_script : 1;   // 0x00000010
+        ub32 is_enabled_joints : 24;        // 0x10000000 to 0x00000020
+        ub32 is_use_yrotn_joint : 1;        // 0x20000000
+        ub32 is_use_transn_joint : 1;       // 0x40000000
+        ub32 is_use_xrotn_joint : 1;        // 0x80000000
+#else
         ub32 is_use_xrotn_joint : 1;        // 0x80000000
         ub32 is_use_transn_joint : 1;       // 0x40000000
         ub32 is_use_yrotn_joint : 1;        // 0x20000000
@@ -60,6 +79,7 @@ union FTAnimDesc
         ub32 is_have_translate_scale : 1;   // 0x00000004
         ub32 is_use_shieldpose : 1;         // 0x00000002
         ub32 is_use_animlocks : 1;          // 0x00000001
+#endif
 
     } flags;
 };

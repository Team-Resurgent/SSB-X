# ssb64-dc: what the build image is made of. The upstream trees that used to
# be git submodules live in the image at these revisions instead, so the repo
# itself carries no third-party source.
#
# Bumping: `scripts/bump_pins.sh` rewrites this from each project's current HEAD;
# then `./run.sh image && ./run.sh build && ./run.sh test`. The oracle tests and the
# asset parity check are what catch a bad bump (the asset exporters parse the
# decomp's source text, so its formatting is load-bearing).

# kos-chain profile. `legacy` is GCC 13.2.0 / binutils 2.43 / newlib 4.3.0 --
# the toolchain this port has always been built with. `stable` (GCC 15.2.0)
# was tried once and abandoned.
TOOLCHAIN_PROFILE=legacy

# KallistiOS -- the SDK the game compiles and links against.
KOS_URL=https://github.com/KallistiOS/KallistiOS.git
KOS_REV=c22f26c99805430e1b29ea9081929240f20cf540

# The decomp. Load-bearing at build time: tools/ssb_*.py read ROM file ids
# from its relocData filenames, parse offsets and tables out of its sources,
# and import its audio_codec / cseq_to_mid modules.
DECOMP_URL=https://github.com/VetriTheRetri/ssb-decomp-re.git
DECOMP_REV=efe9b01be31cc92f62a42748f5da270e02a6a368

# glankk's n64 tools, for the gfxdis display-list disassembler that
# tools/check/verify_dl.py cross-checks our decode against. Verification only:
# build with WITH_GFXDIS=0 to drop it.
N64_URL=https://github.com/glankk/n64.git
N64_REV=5d35e3aa505080250b4f3eec0edafb0d24365da8

# Optional amd64 fast path (`./run.sh image --prebuilt`): KallistiOS's own
# toolchain image, which skips the hour-long compiler build. Alpine/musl, so
# the dev stage switches to Alpine with it. The tag floats, hence the digest.
TOOLCHAIN_IMAGE=docker.io/pcercuei/dreamcast-toolchain
TOOLCHAIN_IMAGE_DIGEST=sha256:8011d20642e05e3d48525fea72f0f64591476df4f8fa35475c772c68c407fcfa

# SH4ZAM -- SH4 math: XMTRX (the FPU back-bank 4x4), FTRV, FIPR, FSCA, FSRRA.
# Header-only here: everything this port calls is SHZ_INLINE, and the four .c
# files hold only invert/quat/decompose, which nothing here uses. So only
# include/ enters the image and no library is linked.
#
# Not taken through kos-ports, whose recipe (external/kos-ports/sh4zam) clones
# GitHub HEAD unpinned and needs cmake in the image.
SH4ZAM_URL=https://github.com/gyrovorbis/sh4zam.git
SH4ZAM_REV=ad353dc2cea596a7c8c7b56b05cbe2e07b84ed4a

# img4dc -- SiZiOUS' cdi4dc, the ISO->CDI wrapper scripts/make_cdi.sh ends
# with. Nothing in KallistiOS writes a Discjuggler container; KOS ships
# elf2bin, scramble and makeip and stops at the ISO. Kazade's fork is the
# one every Dreamcast project uses (garbage-bus included).
IMG4DC_URL=https://github.com/Kazade/img4dc.git
IMG4DC_REV=d28df15db97db1b410e52191eeb45534dcbba252

# Where `./run.sh image` looks for a published build image (amd64 and arm64)
# before compiling one. Empty builds locally. Tagged by `./scripts/ctr.sh name`.
IMAGE_REGISTRY=ghcr.io/beigeceleron/ssb64-dc
